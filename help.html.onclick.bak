<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Help Center — BSTM Marketplace</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
  <link rel="manifest" href="/manifest.json">
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap");
    *{font-family:'Inter',sans-serif;box-sizing:border-box;}
    html,body{overflow-x:hidden;max-width:100vw;}
    .gradient-bg{background:linear-gradient(135deg,#7C3AED 0%,#4F46E5 100%);}
    .faq-answer{max-height:0;overflow:hidden;transition:max-height 0.35s ease;}
    .faq-answer.active{max-height:600px;}
    .faq-icon{transition:transform 0.3s;}
    .faq-item.open .faq-icon{transform:rotate(180deg);}
  </style>
</head>
<body style="background:#F8F7FF;">
<div id="bstm-nav"></div>

<!-- Header -->
<header class="gradient-bg text-white shadow-xl">
  <div class="max-w-7xl mx-auto px-6 py-12 text-center">
    <div class="w-20 h-20 bg-white rounded-2xl flex items-center justify-center mx-auto mb-6">
      <i class="fas fa-question-circle text-purple-600 text-4xl"></i>
    </div>
    <h1 class="text-5xl font-bold mb-4">How Can We Help?</h1>
    <p class="text-xl text-purple-100 mb-8">Find answers to your questions</p>
    <div class="max-w-2xl mx-auto">
      <div class="relative">
        <i class="fas fa-search absolute left-6 top-5 text-gray-400 text-xl"></i>
        <input type="text" id="help-search" placeholder="Search for help..." class="w-full pl-16 pr-6 py-4 rounded-xl text-gray-800 text-lg focus:outline-none focus:ring-4 focus:ring-purple-300" oninput="searchHelp(this.value)">
      </div>
    </div>
  </div>
</header>

<div class="max-w-7xl mx-auto px-6 py-12">

  <!-- Quick Links -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
    <a href="#buying" class="bg-white rounded-2xl shadow-lg p-8 text-center hover:shadow-2xl transition-all">
      <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"><i class="fas fa-shopping-cart text-blue-600 text-2xl"></i></div>
      <h3 class="text-xl font-bold text-gray-800 mb-2">Buying</h3>
      <p class="text-sm text-gray-600">How to purchase products</p>
    </a>
    <a href="#selling" class="bg-white rounded-2xl shadow-lg p-8 text-center hover:shadow-2xl transition-all">
      <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4"><i class="fas fa-store text-purple-600 text-2xl"></i></div>
      <h3 class="text-xl font-bold text-gray-800 mb-2">Selling</h3>
      <p class="text-sm text-gray-600">Start selling on BSTM</p>
    </a>
    <a href="#thb" class="bg-white rounded-2xl shadow-lg p-8 text-center hover:shadow-2xl transition-all">
      <div class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4"><i class="fas fa-coins text-yellow-600 text-2xl"></i></div>
      <h3 class="text-xl font-bold text-gray-800 mb-2">THB Rewards</h3>
      <p class="text-sm text-gray-600">Earn & use THoBoCoin</p>
    </a>
    <a href="#account" class="bg-white rounded-2xl shadow-lg p-8 text-center hover:shadow-2xl transition-all">
      <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"><i class="fas fa-user-circle text-green-600 text-2xl"></i></div>
      <h3 class="text-xl font-bold text-gray-800 mb-2">Account</h3>
      <p class="text-sm text-gray-600">Manage your profile</p>
    </a>
  </div>

  <!-- Buying FAQ -->
  <div id="buying" class="bg-white rounded-2xl shadow-lg p-8 mb-8">
    <h2 class="text-3xl font-bold text-gray-800 mb-8"><i class="fas fa-shopping-cart text-blue-600 mr-3"></i>Buying on BSTM</h2>
    <div class="space-y-2">
      <div class="faq-item border rounded-xl overflow-hidden">
        <button class="w-full flex justify-between items-center p-5 text-left font-semibold text-gray-800 hover:bg-gray-50" onclick="toggleFaq(this)">
          How do I place an order?
          <i class="fas fa-chevron-down text-gray-400 faq-icon"></i>
        </button>
        <div class="faq-answer">
          <div class="px-5 pb-5 text-gray-600">
            <ol class="list-decimal list-inside space-y-2 ml-2">
              <li>Browse products or use the search function</li>
              <li>Click on a product to view details</li>
              <li>Click "Add to Cart" or "Buy Now"</li>
              <li>Review your cart and proceed to checkout</li>
              <li>Fill in delivery information</li>
              <li>Choose payment method</li>
              <li>Confirm and place your order</li>
            </ol>
          </div>
        </div>
      </div>
      <div class="faq-item border rounded-xl overflow-hidden">
        <button class="w-full flex justify-between items-center p-5 text-left font-semibold text-gray-800 hover:bg-gray-50" onclick="toggleFaq(this)">
          What payment methods are accepted?
          <i class="fas fa-chevron-down text-gray-400 faq-icon"></i>
        </button>
        <div class="faq-answer">
          <div class="px-5 pb-5 text-gray-600">
            <ul class="list-disc list-inside space-y-2 ml-2">
              <li><strong>Paystack:</strong> Credit/Debit cards and Mobile Money</li>
              <li><strong>THoBoCoin (THB):</strong> Use your THB wal<!-- EXTRACTED TO js/pages/help.js -->
<script src="components/smart-loader.js"></script>
<script type="module" src="js/app.js"></script>
<script type="module" src="js/pages/help.js"></script>
<!-- EXTRACTED TO js/pages/help.js -->
</body>
            </html>
