# NOTE: This _headers file format only works on Netlify or Cloudflare Pages.
# GitHub Pages (the current deploy target, via `gh-pages -d .`) does NOT
# support custom response headers at all — this file is silently ignored
# there. vercel.json in the repo root has the equivalent config for Vercel.
# If staying on GitHub Pages long-term, security headers need to come from
# a CDN in front of it (e.g. Cloudflare) since GH Pages has no server config.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

/*.html
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=86400

/css/*
  Cache-Control: public, max-age=86400

/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
