<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KYC Verification - BSTM</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    
</head>
<body class="bg-gray-50">
    
    <div id="bstm-nav"></div>

    <div class="max-w-3xl mx-auto px-6 py-12">
        
        <!-- Header -->
        <div class="text-center mb-12">
            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="fas fa-shield-alt text-green-600 text-4xl"></i>
            </div>
            <h1 class="text-4xl font-bold text-gray-800 mb-4">Seller Verification (KYC)</h1>
            <p class="text-xl text-gray-600">Complete verification to start selling on BSTM</p>
        </div>

        <!-- Progress Steps -->
        <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
            <div class="flex items-center justify-between mb-8">
                <div class="flex flex-col items-center flex-1">
                    <div id="step1" class="w-12 h-12 bg-purple-600 text-white rounded-full flex items-center justify-center font-bold mb-2">1</div>
                    <p class="text-sm font-semibold text-purple-600">Personal Info</p>
                </div>
                <div class="flex-1 h-1 bg-gray-300 mx-4"></div>
                <div class="flex flex-col items-center flex-1">
                    <div id="step2" class="w-12 h-12 bg-gray-300 text-white rounded-full flex items-center justify-center font-bold mb-2">2</div>
                    <p class="text-sm font-semibold text-gray-400">Documents</p>
                </div>
                <div class="flex-1 h-1 bg-gray-300 mx-4"></div>
                <div class="flex flex-col items-center flex-1">
                    <div id="step3" class="w-12 h-12 bg-gray-300 text-white rounded-full flex items-center justify-center font-bold mb-2">3</div>
                    <p class="text-sm font-semibold text-gray-400">Review</p>
                </div>
            </div>

            <!-- Step 1: Personal Info -->
            <div id="stepContent1" class="step-content">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Personal Information</h2>
                <form id="personalInfoForm" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-gray-700 font-semibold mb-2">Full Legal Name *</label>
                            <input type="text" required class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:outline-none focus:border-purple-600" placeholder="John Doe">
                        </div>
                        <div>
                            <label class="block text-gray-700 font-semibold mb-2">Date of Birth *</label>
                            <input type="date" required class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:outline-none focus:border-purple-600">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-gray-700 font-semibold mb-2">Omang Number *</label>
                            <input type="text" required class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:outline-none focus:border-purple-600" placeholder="123456789">
                        </div>
                        <div>
                            <label class="block text-gray-700 font-semibold mb-2">Phone Number *</label>
                            <input type="tel" required class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:outline-none focus:border-purple-600" placeholder="+267 71234567">
                        </div>
                    </div>

                    <div>
                        <label class="block text-gray-700 font-semibold mb-2">Physical Address *</label>
                        <textarea required class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:outline-none focus:border-purple-600" rows="3" placeholder="Plot 1234, Block 5, Gaborone"></textarea>
                    </div>

                    <div>
                        <label class="block text-gray-700 font-semibold mb-2">Business Type *</label>
                        <select required class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl focus:outline-none focus:border-purple-600">
                            <option value="">Select type...</option>
                            <option value="individual">Individual Seller</option>
                            <option value="registered">Registered Business</option>
                            <option value="cooperative">Cooperative</option>
                        </select>
                    </div>

                    <button type="button" onclick="nextStep(2)" class="w-full bg-purple-600 hover:bg-purple-700 text-white py-4 rounded-xl font-bold text-lg">
                        Continue to Documents
                        <i class="fas fa-arrow-right ml-2"></i>
                    </button>
                </form>
            </div>

            <!-- Step 2: Documents -->
            <div id="stepContent2" class="step-content hidden">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Upload Documents</h2>
                
                <div class="space-y-6">
                    <!-- Omang Upload -->
                    <div class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center hover:border-purple-600 transition-all">
                        <i class="fas fa-id-card text-gray-400 text-4xl mb-4"></i>
                        <h3 class="font-bold text-gray-800 mb-2">Omang (National ID)</h3>
                        <p class="text-sm text-gray-600 mb-4">Upload clear photo of front and back</p>
                        <input type="file" id="omangUpload" accept="image/*" multiple class="hidden">
                        <button onclick="<!-- EXTRACTED TO js/pages/kyc-verification.js -->
<script src="components/smart-loader.js"></script>
<script type="module" src="js/app.js"></script>

</script>
</body>
</html>
